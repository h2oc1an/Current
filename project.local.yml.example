    settings:
      base:
        CODE_SIGN_STYLE: Manual
        CODE_SIGN_IDENTITY: "Apple Development: YOUR NAME (XXXXXXXXXX)"
        DEVELOPMENT_TEAM: XXXXXXXXXX
